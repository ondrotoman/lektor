{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,
    "removeComments": true,
    "importHelpers": false,
    "noEmitHelpers": true,
    "sourceMap": false,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./bin",
    "allowImportingTsExtensions": false,
    "noEmit": false
  }
}
